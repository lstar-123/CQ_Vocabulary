# ── Flask ──
SECRET_KEY=change-me-to-a-random-string

# ── PostgreSQL ──
# 主数据库：用户、测验记录、分组记忆历史
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vocab_quiz
# 词书数据库：单元、词汇、phonics 数据
WORDS_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vocab_quiz_words

# ── Youdao TTS (可选，用于发音) ──
# YOUDAO_APP_KEY=your_app_key
# YOUDAO_APP_SECRET=your_app_secret
